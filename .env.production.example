APP_NAME="Roça Nossa"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
APP_URL=https://app.rocanossa.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rocanossa
DB_USERNAME=rocanossa
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=resend
MAIL_FROM_ADDRESS="no-reply@rocanossa.com.br"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

FARM_TRIAL_DAYS=14

ASAAS_ENV=production
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_PLAN_VALUE=99.90
ASAAS_PLAN_CYCLE=MONTHLY
ASAAS_BLOCK_AFTER_DAYS=7

# Backup S3 (opcional)
# S3_BACKUP_BUCKET=meu-bucket-backup
