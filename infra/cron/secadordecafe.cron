# Cron entries do secadordecafe.
# Instalação: copie estas linhas para /etc/cron.d/secadordecafe (root)
# ou edite com `crontab -e` (root).

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
SHELL=/bin/bash

# Laravel scheduler (chama subscriptions:block-overdue diariamente às 03:00)
* * * * * www-data cd /var/www/secadordecafe/current && php artisan schedule:run >> /var/log/secadordecafe/scheduler.log 2>&1

# Backup MySQL diário 02:30
30 2 * * * root /var/www/secadordecafe/current/bin/deploy/backup.sh >> /var/log/secadordecafe/backup.log 2>&1
